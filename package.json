{
  "name": "apple-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:0-lint": "oxlint",
    "check:1-tsc": "tsc --noEmit",
    "check:2-type-coverage": "type-coverage -p ./tsconfig.app.json --at-least 100",
    "check": "run-s check:*"
  },
  "overrides": {
    "type-coverage": {
      "typescript": "npm:@typescript/typescript6@^6"
    },
    "type-coverage-core": {
      "typescript": "npm:@typescript/typescript6@^6"
    }
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.3.5",
    "gsap": "^3.15.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "npm-run-all2": "^8.0.4",
    "oxlint": "^1.90.0",
    "type-coverage": "^2.31.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}